#!url=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/fix.sgmodule
#!name=整合模块
#!desc=2026-01-20 14:38:00
#!arguments=屏蔽上传按钮:true, 屏蔽选段按钮:true, 屏蔽Shorts按钮:false, 启用调试模式:false, 字幕翻译语言:off
#!arguments-desc=\n▶ 参数说明:\n\n - 屏蔽按钮: 默认开启，可手动切换\n\n - 调试模式: 默认关闭，非调试无需切换\n\n - 翻译语言: 默认关闭，可自定义语言代码\n\n\n▶ 语言代码：\n\n - 翻译语言可根据需求自定义，语言代码遵循Google Translate Languages Codes，示例如下↓\n\n - 简中: zh-Hans，日语: ja，韩语: ko，西语: es，法语: fr
#

[URL Rewrite]
# ===== BEGIN: 酷安去广告 =====
# source: http://script.hub/file/_start_/https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js/_end_/coolapk.sgmodule?type=qx-rewrite&n=%E9%85%B7%E5%AE%89%E5%8E%BB%E5%B9%BF%E5%91%8A%40ddgksf2013+%E5%BA%94%E7%94%A8%E5%87%80%E5%8C%96&headers=User-Agent:surge&del=true&jqEnabled=true&target=shadowrocket-module&category=ddgksf2013
# type: manual
# last-sync: 2026-07-12
# > 酷安_屏蔽热词@ddgksf2013
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200
# ===== END: 酷安去广告 =====

[Script]
# ===== BEGIN: 酷安去广告 =====
# source: http://script.hub/file/_start_/https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js/_end_/coolapk.sgmodule?type=qx-rewrite&n=%E9%85%B7%E5%AE%89%E5%8E%BB%E5%B9%BF%E5%91%8A%40ddgksf2013+%E5%BA%94%E7%94%A8%E5%87%80%E5%8C%96&headers=User-Agent:surge&del=true&jqEnabled=true&target=shadowrocket-module&category=ddgksf2013
# type: manual
# last-sync: 2026-07-12
# > 酷安_开屏广告@ddgksf2013
coolapk = type=http-response, pattern=^https?:\/\/api.coolapk.com\/v6\/main\/init, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60

# > 酷安_推广广告@ddgksf2013
coolapk = type=http-response, pattern=^https?:\/\/api.coolapk.com\/v6\/dataList, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60

# > 酷安_首页广告@ddgksf2013
coolapk = type=http-response, pattern=^https?:\/\/api.coolapk.com\/v6\/main\/indexV8, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60

# > 酷安_评论广告@ddgksf2013
coolapk = type=http-response, pattern=^https?:\/\/api.coolapk.com\/v6\/feed\/replyList, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60

# > 酷安_商品推广@ddgksf2013
coolapk = type=http-response, pattern=^https?:\/\/api.coolapk.com\/v6\/feed\/detail, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60

# > 酷安_酷品页推广@ddgksf2013
coolapk = type=http-response, pattern=https://api.coolapk.com/v6/page/dataList\?.*title=%E9%85, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/kuan/coolapk.js, requires-body=true, max-size=-1, timeout=60
# ===== END: 酷安去广告 =====

# ===== BEGIN: YouTubeNoAd =====
# source: https://raw.githubusercontent.com/iab0x00/ProxyRules/main/Rewrite/YouTubeNoAd.sgmodule
# type: raw
# scripts-dir: youtube
# last-sync: 2026-07-12
youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/youtube/youtube.response.js, requires-body=true, binary-body-mode=true, max-size=0, argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"
youtube.request.init = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/youtube/youtube.request.js, requires-body=true, binary-body-mode=true, max-size=0, argument="{"captionLang":"{{{字幕翻译语言}}}"}"
youtube.request.log_event = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/youtube/youtube.request.js, requires-body=true, binary-body-mode=true, max-size=0
# ===== END: YouTubeNoAd =====

# ===== BEGIN: wloc =====
# source: https://raw.githubusercontent.com/Yu9191/wloc/refs/heads/main/modules/wloc.module
# type: raw
# scripts-dir: wloc
# last-sync: 2026-08-06
Apple WLOC = type=http-response,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/wloc/wloc.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/kun12356/ippure/refs/heads/main/scripts/wloc/wloc-settings.js
# ===== END: wloc =====

[MITM]
hostname = %APPEND% *.googlevideo.com, api.coolapk.com, gs-loc-cn.apple.com, gs-loc.apple.com, youtubei.googleapis.com
