#!name=贴吧去广告+精简底栏版
#!desc=集成向晚馆去广告与墨鱼底栏精简。移除广告、移除小卖部、移除游戏中心。
#!author=向晚馆, ddgksf2013 & Gemini整理
#!date=2026-01-20

[Script]
# 1. 贴吧 JSON 去广告 (首页、帖子列表等)
tieba-json = type=http-response, pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?), script-path=https://raw.githubusercontent.com/XiangwanGuan/Shadowrocket/main/Rewrite/JS/tieba-json.js, requires-body=true, max-size=0

# 2. 贴吧 Proto 二进制去广告 (Feed流广告)
tieba-proto = type=http-response, pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))(\?cmd)?$, script-path=https://raw.githubusercontent.com/XiangwanGuan/Shadowrocket/main/Rewrite/JS/tieba-proto.js, requires-body=true, max-size=0, binary-body-mode=true

# 3. 专用底栏精简补丁 (移除小卖部、游戏中心等)
tieba-footer = type=http-response, pattern=^https?:\/\/tiebac\.baidu\.com\/c\/f\/frs\/page, script-path=https://raw.githubusercontent.com/ddgksf2013/scripts/master/tieba_footer.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba.baidu.com
